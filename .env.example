# ---------------------------------------------------------------------------
# Supabase — required
#
# Project Settings -> API in your Supabase dashboard.
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose to the browser: every query it
# makes is still gated by the row level security policies in
# supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. NEVER expose this to the browser and never commit it.
# It bypasses row level security entirely. Used only for two things:
#   - rendering public profile pages for signed-out visitors
#   - recording a page view after the server has verified the link exists
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# OpenAI — optional
#
# Leave OPENAI_API_KEY blank and the app still works: profile generation falls
# back to a deterministic, per-audience template writer that needs no API key
# and costs nothing. That path is what makes this repo runnable by anyone who
# clones it. See lib/ai/fallback.ts.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=

# Override the model if you want. Defaults to gpt-4.1.
# OPENAI_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Site — optional
# ---------------------------------------------------------------------------

# Canonical origin, used to build absolute URLs for social preview cards.
# On Vercel this is inferred automatically; set it for local or custom domains.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
